# ──────────────────────────────────────────
# AI Interview Coach — Environment Variables
# ──────────────────────────────────────────

# Groq API key (FREE) — get it at https://console.groq.com
GROQ_API_KEY=gsk_...

# LLM model (free Groq models)
LLM_MODEL=llama3-8b-8192

# Embedding: always "local" (free, no API needed)
EMBEDDING_BACKEND=local

# App settings
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
SECRET_KEY=change-this-to-a-random-secret-key

# Database
DATABASE_URL=sqlite:///./data/interview_coach.db

# ChromaDB persistence directory
CHROMA_PERSIST_DIR=./data/vectordb

# Max questions per session
MAX_QUESTIONS=10

# Streamlit connects to API at this URL
API_BASE_URL=http://localhost:8000
